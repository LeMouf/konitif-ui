{
  "schemaVersion": "1.0.0",
  "package": "@konitif/ui",
  "intent": "Project and manipulate the Workbench without owning its canonical states.",
  "clusters": [
    {
      "id": "shell",
      "title": "Shell and observability",
      "summary": "Application frame, commands, and runtime readings.",
      "authority": "Shell projection.",
      "owns": [
        "visual composition",
        "UI intent"
      ],
      "doesNotOwn": [
        "runtime",
        "workspace"
      ],
      "workflow": [
        "Project",
        "Interact",
        "Emit"
      ],
      "sourcePrefixes": [
        "shell/"
      ]
    },
    {
      "id": "workspace-layout",
      "title": "Layout and hosting",
      "summary": "Surfaces, panels, stacks, and tool hosts.",
      "authority": "Spatial projection of the workspace.",
      "owns": [
        "layout rendering",
        "gestures"
      ],
      "doesNotOwn": [
        "canonical tree"
      ],
      "workflow": [
        "Receive",
        "Arrange",
        "Command"
      ],
      "sourcePrefixes": [
        "layout/"
      ]
    },
    {
      "id": "launch",
      "title": "Launch flow",
      "summary": "Preflight, project selection, and initialization.",
      "authority": "Projection of startup states.",
      "owns": [
        "launch screens"
      ],
      "doesNotOwn": [
        "project admission"
      ],
      "workflow": [
        "Verify",
        "Select",
        "Initialize"
      ],
      "sourcePrefixes": [
        "launch/"
      ]
    },
    {
      "id": "primitives",
      "title": "Interaction primitives",
      "summary": "Reusable controls and progressive disclosure.",
      "authority": "Local UI behavior.",
      "owns": [
        "interaction",
        "reading preferences"
      ],
      "doesNotOwn": [
        "domain meaning"
      ],
      "workflow": [
        "Compose",
        "Display",
        "Emit"
      ],
      "sourcePrefixes": [
        "primitives/",
        "audio/"
      ]
    },
    {
      "id": "widgets-tools",
      "title": "Widgets and tools",
      "summary": "Hosting and projection of specialized contributions.",
      "authority": "Projection of registered contributions.",
      "owns": [
        "zones",
        "placement",
        "launcher"
      ],
      "doesNotOwn": [
        "tool modules"
      ],
      "workflow": [
        "Resolve",
        "Mount",
        "Project"
      ],
      "sourcePrefixes": [
        "widgets/",
        "tools/"
      ]
    },
    {
      "id": "platform-services",
      "title": "Projection services",
      "summary": "Localization, icons, themes, portal, debugging, and metrics.",
      "authority": "Technical interface services.",
      "owns": [
        "i18n",
        "icons",
        "portal",
        "metrics"
      ],
      "doesNotOwn": [
        "business authority"
      ],
      "workflow": [
        "Configure",
        "Provide",
        "Observe"
      ],
      "sourcePrefixes": [
        "i18n/",
        "icons/",
        "themes/",
        "portal/",
        "performance/",
        "debug/",
        "design-system/"
      ]
    }
  ]
}
